%arrow with twiddle for bijection/isomorphism
%modified from https://tex.stackexchange.com/questions/480739/placing-sim-above-to-with-correct-spacing
\newcommand{\simto}{\stackrel{\mspace{-7mu}\sim}{\smash{\midrightarrow}\rule{0pt}{0.5ex}}}

%broken arrow for rational maps
%https://tex.stackexchange.com/a/257516
\newcommand{\dashto}{\mathrel{\ThisStyle{\ooalign{$\SavedStyle\midrightarrow$\cr%
\hfil\textcolor{white}{\rule{2\LMpt}{1\LMex}}\kern2\LMpt\hfil}}}}
%and the birational symbol, combining the two above
\newcommand{\simdashto}{\stackrel{\mspace{-7mu}\sim}{\smash{\dashto}\rule{0pt}{0.5ex}}}

%a birational \simeq for Bella
\newcommand{\birateq}{\mathrel{\ThisStyle{\ooalign{$\SavedStyle\simeq$\cr%
\hfil\textcolor{white}{\rule{2\LMpt}{1\LMpt}}\hfil}}}}


